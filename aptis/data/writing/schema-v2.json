{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "/aptis/data/writing/schema-v2.json",
  "title": "ForLanguage Aptis Writing Bank v2",
  "type": "object",
  "required": ["schema_version", "release", "topics", "rubrics", "tests"],
  "properties": {
    "schema_version": {"const": "2.0.0"},
    "release": {"$ref": "#/$defs/release"},
    "topics": {"type": "array", "items": {"$ref": "#/$defs/topic"}},
    "rubrics": {"type": "array", "items": {"$ref": "#/$defs/rubric"}},
    "tests": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/test"}}
  },
  "$defs": {
    "status": {"enum": ["DRAFT", "IN_REVIEW", "PUBLISHED_DEMO", "PUBLISHED_FINAL", "RETIRED"]},
    "release": {
      "type": "object",
      "required": ["release_id", "status", "created_at", "bank_version"],
      "properties": {
        "release_id": {"type": "string", "pattern": "^WR-[0-9]{4}\\.[0-9]{2}-R[0-9]+$"},
        "status": {"$ref": "#/$defs/status"},
        "created_at": {"type": "string", "format": "date-time"},
        "bank_version": {"type": "string"},
        "notes": {"type": "string"}
      }
    },
    "topic": {
      "type": "object",
      "required": ["topic_id", "title_en", "title_vi", "status"],
      "properties": {
        "topic_id": {"type": "string", "pattern": "^WR-TOP-[A-Z0-9-]+$"},
        "title_en": {"type": "string", "minLength": 2},
        "title_vi": {"type": "string", "minLength": 2},
        "status": {"$ref": "#/$defs/status"}
      }
    },
    "rubric": {
      "type": "object",
      "required": ["rubric_id", "level", "dimensions", "status"],
      "properties": {
        "rubric_id": {"type": "string", "pattern": "^WR-RUB-[A-Z0-9-]+$"},
        "level": {"enum": ["B1", "B2", "C1"]},
        "dimensions": {
          "type": "array",
          "minItems": 4,
          "items": {"enum": ["task_fulfilment", "grammar_accuracy", "vocabulary_range", "cohesion", "register", "word_limit"]}
        },
        "status": {"$ref": "#/$defs/status"}
      }
    },
    "task": {
      "type": "object",
      "required": ["task_id", "part", "type", "prompt", "min_words", "max_words", "formality", "status"],
      "properties": {
        "task_id": {"type": "string", "pattern": "^WT[0-9]{2,3}-P[1-4](A|B)?$"},
        "part": {"type": "integer", "minimum": 1, "maximum": 4},
        "type": {"enum": ["short_answers", "short_message", "social_responses", "informal_email", "formal_email"]},
        "prompt": {"type": "string", "minLength": 10},
        "questions": {"type": "array", "items": {"type": "string", "minLength": 3}},
        "min_words": {"type": "integer", "minimum": 1},
        "max_words": {"type": "integer", "minimum": 1},
        "formality": {"enum": ["short", "neutral", "informal", "formal"]},
        "status": {"$ref": "#/$defs/status"},
        "review_note": {"type": "string"}
      }
    },
    "test": {
      "type": "object",
      "required": ["test_id", "title", "topic_id", "level", "duration_seconds", "rubric_id", "status", "version", "tasks"],
      "properties": {
        "test_id": {"type": "string", "pattern": "^WT[0-9]{2,3}$"},
        "title": {"type": "string", "minLength": 5},
        "topic_id": {"type": "string"},
        "topic": {"type": "string"},
        "level": {"enum": ["B1", "B2", "C1"]},
        "duration_seconds": {"type": "integer", "minimum": 600},
        "rubric_id": {"type": "string"},
        "status": {"$ref": "#/$defs/status"},
        "version": {"type": "string"},
        "source_note": {"type": "string"},
        "reviewed_by": {"type": "array", "items": {"type": "string"}},
        "tasks": {"type": "array", "minItems": 5, "maxItems": 5, "items": {"$ref": "#/$defs/task"}}
      }
    }
  }
}
