{
  "$schema":"https://json-schema.org/draft/2020-12/schema","$id":"/aptis/data/speaking/schema-v2.json","title":"ForLanguage Aptis Speaking Bank v2","type":"object","required":["schema_version","release","topics","rubrics","images","tests"],
  "properties":{"schema_version":{"const":"2.0.0"},"release":{"$ref":"#/$defs/release"},"topics":{"type":"array","items":{"$ref":"#/$defs/topic"}},"rubrics":{"type":"array","items":{"$ref":"#/$defs/rubric"}},"images":{"type":"array","items":{"$ref":"#/$defs/image"}},"tests":{"type":"array","minItems":1,"items":{"$ref":"#/$defs/test"}}},
  "$defs":{
    "status":{"enum":["DRAFT","IN_REVIEW","PUBLISHED_DEMO","PUBLISHED_FINAL","RETIRED"]},
    "release":{"type":"object","required":["release_id","status","created_at","bank_version"],"properties":{"release_id":{"type":"string","pattern":"^SPK-[0-9]{4}\\.[0-9]{2}-R[0-9]+$"},"status":{"$ref":"#/$defs/status"},"created_at":{"type":"string","format":"date-time"},"bank_version":{"type":"string"},"notes":{"type":"string"}}},
    "topic":{"type":"object","required":["topic_id","title_en","title_vi","status"],"properties":{"topic_id":{"type":"string","pattern":"^SPK-TOP-[A-Z0-9-]+$"},"title_en":{"type":"string"},"title_vi":{"type":"string"},"status":{"$ref":"#/$defs/status"}}},
    "rubric":{"type":"object","required":["rubric_id","level","dimensions","status"],"properties":{"rubric_id":{"type":"string","pattern":"^SPK-RUB-[A-Z0-9-]+$"},"level":{"enum":["B1","B2","C1"]},"dimensions":{"type":"array","minItems":6,"maxItems":6,"uniqueItems":true,"items":{"enum":["task_fulfilment","fluency","grammar_accuracy","vocabulary_range","pronunciation","coherence"]}},"status":{"$ref":"#/$defs/status"}}},
    "image":{"type":"object","required":["image_id","file_path","alt_text","source","license","checksum","status"],"properties":{"image_id":{"type":"string","pattern":"^SPK-IMG-[A-Z0-9-]+$"},"file_path":{"type":"string"},"alt_text":{"type":"string","minLength":5},"source":{"type":"string","minLength":2},"license":{"type":"string","minLength":2},"attribution":{"type":"string"},"checksum":{"type":"string","pattern":"^[a-f0-9]{64}$"},"status":{"$ref":"#/$defs/status"}}},
    "task":{"type":"object","required":["task_id","part","prompt","preparation_seconds","response_seconds","topic_id","image_ids","status","review_note"],"properties":{"task_id":{"type":"string","pattern":"^ST[0-9]{2,3}-P[1-4]-Q[0-9]+$"},"part":{"type":"integer","minimum":1,"maximum":4},"prompt":{"type":"string","minLength":10},"preparation_seconds":{"type":"integer","minimum":0},"response_seconds":{"type":"integer","minimum":10},"topic_id":{"type":"string"},"topic":{"type":"string"},"image_ids":{"type":"array","maxItems":2,"items":{"type":"string"}},"status":{"$ref":"#/$defs/status"},"review_note":{"type":"string","minLength":10}}},
    "test":{"type":"object","required":["test_id","title","level","rubric_id","status","version","source_note","format_reference","reviewed_by","tasks"],"properties":{"test_id":{"type":"string","pattern":"^ST[0-9]{2,3}$"},"title":{"type":"string"},"level":{"enum":["B1","B2","C1"]},"rubric_id":{"type":"string"},"status":{"$ref":"#/$defs/status"},"version":{"type":"string"},"source_note":{"type":"string","minLength":20},"format_reference":{"type":"string","minLength":20},"reviewed_by":{"type":"array","minItems":1,"items":{"type":"string"}},"tasks":{"type":"array","minItems":10,"maxItems":10,"items":{"$ref":"#/$defs/task"}}}}
  }
}
